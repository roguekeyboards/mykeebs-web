# Local dev values; copy to .env. Deployed builds use the committed .env.dev and .env.prod.

# client_id of this app's first_party_public Connected App client in the Stytch Test project.
PUBLIC_STYTCH_CLIENT_ID=

# Base URL of the kbdb REST API, e.g. https://jay.api.mykeebs.dev.
PUBLIC_KBDB_API_BASE_PATH=

# OIDC issuer the auth endpoints are discovered from, e.g. https://auth.jay.mykeebs.dev.
PUBLIC_OIDC_ISSUER=

# kbdb's uploads bucket origin, which presigned image PUTs go to. Only the build reads it, for the CSP.
KBDB_UPLOADS_ORIGIN=

# kbdb's images domain, which image URLs point at, e.g. https://jay.images.mykeebs.dev. Only the build reads it, for the CSP.
KBDB_IMAGES_ORIGIN=
